SECRET_KEY=change-this-in-production-use-a-strong-random-key
DEBUG=False
ALLOWED_HOSTS=yourdomain.com,api.yourdomain.com,localhost,127.0.0.1
CORS_ALLOWED_ORIGINS=https://yourdomain.com,http://localhost

# Database Configuration (MySQL)
DB_NAME=workizo_db
DB_USER=workizo_user
DB_PASSWORD=your_secure_db_password
DB_HOST=db
DB_PORT=3306

# Redis Channel Layer for WebSockets
REDIS_URL=redis://redis:6379/0

# SMTP Email Settings
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_HOST_USER=your_email@gmail.com
EMAIL_HOST_PASSWORD=your_app_password
EMAIL_USE_TLS=True
DEFAULT_FROM_EMAIL="WORKIZO Support <your_email@gmail.com>"

# Payment Settings (Razorpay)
RAZORPAY_KEY_ID=rzp_live_your_key_id
RAZORPAY_KEY_SECRET=your_live_key_secret

# OAuth & Security
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
